generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum EvidenceStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ChecklistResult {
  CUMPLE
  NO_CUMPLE
  NO_APLICA
}

enum SummaryChecklistResult {
  CUMPLE
  NO_CUMPLE
  PARCIAL
}

enum ProjectUserRole {
  DOCENTE
  EVALUADOR
  COORDINADOR
  ESTUDIANTE
}

enum YesNoOption {
  SI
  NO
}

enum SolvedProblemOption {
  SI
  PARCIAL
  NO
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  projectUsers ProjectUser[]
  evidences    Evidence[]

  @@map("users")
}

model Company {
  id       Int       @id @default(autoincrement())
  nombre   String
  sector   String
  contacto String
  email    String?
  telefono String?
  projects Project[]

  @@map("companies")
}

model Project {
  id                  Int                 @id @default(autoincrement())
  companyId           Int
  titulo              String
  descripcionProblema String
  resultadoEsperado   String
  estado              ProjectStatus       @default(PENDING)
  fechaInicio         DateTime?
  fechaFin            DateTime?
  company             Company             @relation(fields: [companyId], references: [id])
  projectUsers        ProjectUser[]
  projectPhases       ProjectPhase[]
  summaryChecklist    SummaryChecklist[]
  businessValidation  BusinessValidation?

  @@map("projects")
}

model ProjectUser {
  id        Int             @id @default(autoincrement())
  projectId Int
  userId    Int
  rol       ProjectUserRole
  project   Project         @relation(fields: [projectId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_users")
}

model Phase {
  id            Int            @id @default(autoincrement())
  nombre        String         @unique
  projectPhases ProjectPhase[]

  @@map("phases")
}

model ProjectPhase {
  id            Int              @id @default(autoincrement())
  projectId     Int
  phaseId       Int
  estado        PhaseStatus      @default(PENDING)
  observaciones String?
  project       Project          @relation(fields: [projectId], references: [id])
  phase         Phase            @relation(fields: [phaseId], references: [id])
  evidences     Evidence[]
  checklist     PhaseChecklist[]

  @@unique([projectId, phaseId])
  @@map("project_phases")
}

model Evidence {
  id             Int            @id @default(autoincrement())
  projectPhaseId Int
  userId         Int
  titulo         String
  descripcion    String?
  archivo        String
  estado         EvidenceStatus @default(PENDING)
  observaciones  String?
  fecha          DateTime       @default(now())
  projectPhase   ProjectPhase   @relation(fields: [projectPhaseId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@map("evidences")
}

model PhaseChecklist {
  id             Int             @id @default(autoincrement())
  projectPhaseId Int
  item           String
  resultado      ChecklistResult
  observacion    String?
  projectPhase   ProjectPhase    @relation(fields: [projectPhaseId], references: [id])

  @@map("phase_checklist")
}

model SummaryChecklist {
  id          Int                    @id @default(autoincrement())
  projectId   Int
  fase        String
  criterio    String
  resultado   SummaryChecklistResult
  observacion String?
  project     Project                @relation(fields: [projectId], references: [id])

  @@map("summary_checklist")
}

model BusinessValidation {
  id                 Int                 @id @default(autoincrement())
  projectId          Int                 @unique
  resolvioProblema   SolvedProblemOption
  esAplicable        YesNoOption
  generaValor        YesNoOption
  deseaImplementarla YesNoOption
  comentarios        String?
  nombreFirmante     String
  cargo              String
  project            Project             @relation(fields: [projectId], references: [id])

  @@map("business_validation")
}
